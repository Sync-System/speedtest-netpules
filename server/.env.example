# Port the server listens on. Most hosts (Render, Railway) set this
# automatically — you usually don't need to set it yourself.
PORT=8787

# Set to "production" when deployed. Enables CSP, and (only in this mode)
# serves the built web/dist frontend from this same server.
NODE_ENV=production

# CORS is open to all origins by design (see app.js) — none of these routes
# use cookies/sessions, so there's nothing origin-specific to restrict, and
# no ALLOWED_ORIGIN variable to set here.
