# Port the server listens on. Most hosts (Render, Railway) set this
# automatically — you usually don't need to set it yourself.
PORT=8787

# Set to "production" when deployed. Enables CSP, and (only in this mode)
# serves the built web/dist frontend from this same server.
NODE_ENV=production

# Who's allowed to call this server's /api/* routes from a browser.
# - Same-origin deployment (frontend served by this server): leave unset.
# - Split deployment (frontend hosted elsewhere, e.g. Vercel/Netlify): set
#   this to that frontend's real URL, no trailing slash. Comma-separate
#   multiple origins (e.g. production + a Vercel preview URL):
# ALLOWED_ORIGIN=https://your-frontend.vercel.app,https://your-frontend-git-preview.vercel.app
