# Leave unset for a same-origin deployment (this Express server also serves
# the built frontend — the normal setup, no config needed).
#
# Set this only when the frontend is hosted separately from the backend
# (e.g. frontend on Vercel/Netlify, backend on Render/Railway). Point it at
# the backend's real URL, no trailing slash:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Number of parallel connections used to measure download/upload. Higher is
# more accurate on fast links (a single TCP stream can't fill a
# high-bandwidth-delay-product path) — but only on a host that can actually
# run several concurrent invocations at once. Confirmed by direct testing:
# a Vercel Hobby backend times out ALL 4 concurrent upload streams together,
# while the identical request sent one at a time succeeds instantly, every
# time, even at the full per-request size. If your backend is on Vercel (or
# behaves the same way), set both to 1. Render/Railway/Fly and other
# persistent-server hosts have no such limit — leave these unset there.
# VITE_DOWNLOAD_STREAMS=1
# VITE_UPLOAD_STREAMS=1
